ml/data/
ml/artifacts/*.keras
apps/mobile/android/
apps/mobile/ios/
apps/mobile/web-build/
apps/mobile/expo-env.d.ts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
apps/mobile/credentials.json
