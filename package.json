{
  "name": "smart-waste",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:migrate": "node scripts/db-apply.mjs",
    "dev:api": "npm run dev -w @sw/api",
    "dev:web": "npm run dev -w @sw/web",
    "dev:mobile": "npm run start -w @sw/mobile",
    "build": "npm run build -w @sw/shared && npm run build -w @sw/api && npm run build -w @sw/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
